# Local runtime paths
MACBOT_CONFIG=config.json
MACBOT_DB=trades.db
MACBOT_MODELS_DIR=models
MACBOT_ML_WEIGHTS_PATH=ml_weights.json
MACBOT_ENSEMBLE_PATH=ensemble_state.json

# Safe research/demo controls
MACBOT_BACKTEST_ONLY=1
MACBOT_STARTUP_ANALYSIS=0
MACBOT_BIND_ALL=0
MACBOT_PORT=8000
MACBOT_DEV_CORS=0
RUST_LOG=macbot=info

# Replace before any non-local deployment. Never commit real values.
MACBOT_API_KEY=replace-with-a-random-api-key
MACBOT_API_SECRET=replace-with-a-long-random-hmac-secret

# Polymarket live credentials — leave empty for simulation/research use.
PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
# 0=EOA, 1=Polymarket Proxy, 2=Gnosis Safe, 3=Deposit Wallet.
# For 1/2/3, provide the deployed wallet that holds the assets. For 0, leave
# funder empty or use the signer address. Deposit Wallets require V2/V3 orders.
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER=
# Explicit trusted HTTPS Polygon mainnet RPC with finalized block/receipt
# support. Required for funded submission; config.private_rpc_url overrides it.
POLYGON_RPC_URL=

# Optional data and notification integrations
CRYPTOPANIC_API_KEY=
MACBOT_DISCORD_WEBHOOK_URL=
MACBOT_TELEGRAM_BOT_TOKEN=
MACBOT_TELEGRAM_CHAT_ID=
